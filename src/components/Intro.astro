---
// Einstieg „Schwarzblende mit Lichtfunken“ (Jamils Konzept 4222: ruhig, Netflix-Doku/A24 statt Countdown).
// Ein goldener Funke gleitet aus dem Dunkel zur Mitte, zieht einen breiten Lichtstreif (wie eine anamorphe Linse),
// das Logo erscheint im Licht, dann blendet das Schwarz weich in den Hero-Film über. Ca. 2,6 s, reines CSS auf einer Uhr.
// Regeln: Ebene lässt Klicks durch (pointer-events: none), „Überspringen“, Esc oder Klick beenden sofort; nur beim ersten
// Seitenaufruf der Sitzung (sessionStorage, seite.js); ohne JS und bei reduzierter Bewegung gar nicht; fest positioniert → kein CLS.
import { u } from "../daten";
---
<div class="intro" aria-hidden="true">
  <span class="intro-streif"></span>
  <span class="intro-funke"></span>
  <img class="intro-logo" src={u("/medien/logo-weiss-480.png")} width="480" height="143" alt="" decoding="async" />
</div>
<button class="intro-skip" type="button" data-intro-skip>Intro überspringen</button>
<style>
  .intro, .intro-skip { display: none; }
  :global(html.mit-intro) .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 200; pointer-events: none; background: #050505;
    animation: blende 0.8s cubic-bezier(0.4, 0, 0.2, 1) 1.85s forwards;
  }
  :global(html.mit-intro) .intro-skip {
    display: inline-flex; position: fixed; z-index: 201; right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); min-height: 2.75rem; align-items: center;
    padding: 0.5rem 1rem; border: 1px solid rgba(243, 241, 236, 0.35); border-radius: 2px; background: rgba(5, 5, 5, 0.6); color: var(--weiss);
    font: 500 0.9rem/1 var(--titel); cursor: pointer; animation: weg 0.25s linear 2.3s forwards;
  }
  .intro > * { grid-area: 1 / 1; }
  .intro-funke { width: 0.9rem; height: 0.9rem; border-radius: 50%; background: #fff3c4;
    box-shadow: 0 0 12px 4px rgba(212, 160, 23, 0.95), 0 0 46px 14px rgba(212, 160, 23, 0.45);
    opacity: 0; animation: funke 1.5s cubic-bezier(0.25, 0.8, 0.25, 1) 0.1s forwards; }
  .intro-streif { width: min(90vw, 60rem); height: 2px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 236, 170, 0.95), rgba(212, 160, 23, 0.55) 40%, rgba(212, 160, 23, 0) 100%);
    opacity: 0; transform: scaleX(0.05); animation: streif 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) 0.75s forwards; }
  .intro-logo { width: min(64vw, 22rem); height: auto; opacity: 0; animation: logo 0.9s var(--ease) 1.05s forwards; }
  @keyframes funke {
    0% { opacity: 0; transform: translate(-22vw, 6vh) scale(0.4); }
    25% { opacity: 1; }
    70% { opacity: 1; transform: translate(0, 0) scale(1); }
    100% { opacity: 0; transform: translate(0, 0) scale(2.2); }
  }
  @keyframes streif { 0% { opacity: 0; transform: scaleX(0.05); } 35% { opacity: 1; } 100% { opacity: 0; transform: scaleX(1); } }
  @keyframes logo { 0% { opacity: 0; filter: blur(8px); transform: scale(0.97); } 100% { opacity: 1; filter: none; transform: none; } }
  @keyframes blende { to { opacity: 0; visibility: hidden; } }
  @keyframes weg { to { opacity: 0; visibility: hidden; } }
  :global(html.mit-intro.intro-weg) .intro, :global(html.mit-intro.intro-weg) .intro-skip { animation: weg 0.25s linear forwards; }
  @media (prefers-reduced-motion: reduce) { .intro, .intro-skip { display: none !important; } }
</style>
