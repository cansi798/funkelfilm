---
// Einstieg: Film-Vorspann 3–2–1 (Jamil Talk 4246, 02.11.2026: „Verwende wieder die erste Animation mit dem Countdown 3, 2, 1“).
// Fassung aus v1 (Commit 77566a1), seit 07.11.2026 in Anthrazit, Gelb #FFCC00 und Off White (Jamil 4892/4894), davor Schwarz/Gold –
// und mit Barlow Condensed für die Ziffern. Ablauf: Vorspann-Kreis mit gelbem Zeiger zählt 3–2–1 → Logo →
// Blende öffnet sich von der Mitte in die Seite (ca. 2,4 s). Ohne Funken/Stern (Jamil Talk 4264: „Startanimation ohne Stern“). Danach startet der Hero-Film (seite.js).
// Regeln: reines CSS auf einer Uhr, Ebene lässt Klicks durch, „Überspringen“/Esc/Klick beenden sofort, einmal je Sitzung,
// ohne JS und bei reduzierter Bewegung gar nicht, fest positioniert → kein Layout-Sprung. Ohne drop-shadow/blur (Leistung).
import { u } from "../daten";
---
<div class="intro" aria-hidden="true">
  <div class="intro-leader">
    <svg class="intro-ring" viewBox="0 0 200 200" width="200" height="200">
      <circle cx="100" cy="100" r="92" /><circle cx="100" cy="100" r="74" />
      <path d="M100 0v200M0 100h200" />
    </svg>
    <span class="intro-sweep"></span>
    <span class="intro-zahl z3">3</span><span class="intro-zahl z2">2</span><span class="intro-zahl z1">1</span>
  </div>
  <img class="intro-logo" src={u("/medien/logo-weiss-480.png")} width="480" height="143" alt="" decoding="async" />
</div>
<button class="intro-skip" type="button" data-intro-skip>Intro überspringen</button>
<style>
  @property --loch { syntax: "<length>"; inherits: false; initial-value: 0px; }
  .intro, .intro-skip { display: none; }
  :global(html.mit-intro) .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 200; pointer-events: none; background: var(--nacht);
    -webkit-mask: radial-gradient(circle at 50% 50%, transparent var(--loch), #000 calc(var(--loch) + 1px));
            mask: radial-gradient(circle at 50% 50%, transparent var(--loch), #000 calc(var(--loch) + 1px));
    animation: iris 0.75s cubic-bezier(0.7, 0, 0.25, 1) 1.6s forwards, weg 0.2s linear 2.3s forwards;
  }
  :global(html.mit-intro) .intro-skip {
    display: inline-flex; position: fixed; z-index: 201; right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); min-height: 2.75rem; align-items: center;
    padding: 0.5rem 1rem; border: 1px solid rgba(243, 241, 236, 0.35); border-radius: 2px; background: rgba(43, 45, 49, 0.75); color: var(--weiss);
    font: 500 0.9rem/1 var(--titel); cursor: pointer; animation: weg 0.2s linear 2.05s forwards;
  }
  .intro > * { grid-area: 1 / 1; }
  .intro-leader { position: relative; width: min(46vmin, 15rem); aspect-ratio: 1; animation: weg 0.25s ease 1.05s forwards; }
  .intro-ring { width: 100%; height: 100%; }
  .intro-ring circle, .intro-ring path { fill: none; stroke: rgba(243, 241, 236, 0.45); stroke-width: 1.5; }
  .intro-ring circle:first-child { stroke: rgba(255, 204, 0, 0.75); }
  .intro-sweep { position: absolute; inset: 4%; border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(255, 204, 0, 0.45), rgba(255, 204, 0, 0) 32%, transparent 100%);
    animation: drehen 0.35s linear 3; }
  .intro-zahl { position: absolute; inset: 0; display: grid; place-items: center; font: 700 clamp(4rem, 16vmin, 7rem)/1 var(--serif); color: var(--weiss); opacity: 0; }
  .z3 { animation: zahl 0.35s steps(1) 0s; }
  .z2 { animation: zahl 0.35s steps(1) 0.35s; }
  .z1 { animation: zahl 0.35s steps(1) 0.7s; }
  .intro-logo { width: min(70vw, 26rem); height: auto; opacity: 0; animation: logo 0.6s var(--ease) 1.05s forwards; }
  @keyframes drehen { to { transform: rotate(360deg); } }
  @keyframes zahl { 0%, 100% { opacity: 1; } }
  @keyframes logo { 0% { opacity: 0; transform: scale(0.92); } 100% { opacity: 1; transform: none; } }
  @keyframes iris { to { --loch: 150vmax; } }
  @keyframes weg { to { opacity: 0; visibility: hidden; } }
  /* Überspringen: sofort ausblenden */
  :global(html.mit-intro.intro-weg) .intro, :global(html.mit-intro.intro-weg) .intro-skip { animation: weg 0.2s linear forwards; }
  @media (prefers-reduced-motion: reduce) { .intro, .intro-skip { display: none !important; } }
</style>
