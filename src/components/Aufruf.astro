---
// Finaler Aufruf (Jamils Konzept): eine einzelne Filmszene läuft sehr langsam im Hintergrund, fast wie ein Kinotrailer.
// Auf allen Seiten gleich. Szene lädt erst, wenn der Abschnitt ins Bild kommt; Pause-Knopf; reduzierte Bewegung = Standbild.
import Skizze from "./Skizze.astro";
import Icon from "./Icon.astro";
import { SCHLUSS, u } from "../daten";
---
<section class="schluss" aria-labelledby="schluss-titel" data-autoclip data-spaet>
  <img class="schluss-bild" src={u("/medien/clips/szene.webp")} width="960" height="540" alt="" loading="lazy" decoding="async" />
  <video class="schluss-film" muted loop playsinline preload="none" data-src={u("/medien/clips/szene.mp4")} data-tempo="0.6" aria-hidden="true" tabindex="-1"></video>
  <div class="schluss-schleier" aria-hidden="true"></div>
  <div class="huelle schluss-inhalt">
    <h2 id="schluss-titel">{SCHLUSS.titel}</h2>
    <p class="schluss-unter"><span class="erzaehlt">{SCHLUSS.unter}<Skizze form="unterstrich" breite={420} hoehe={26} seed={81} klasse="schluss-strich" /></span></p>
    <a class="knopf" href={u("/kontakt/")}>{SCHLUSS.knopf}</a>
  </div>
  <button class="clip-pause" type="button" data-pause hidden aria-pressed="false">
    <span class="p-an"><Icon name="pause" /><span class="sr">Film anhalten</span></span>
    <span class="p-aus"><Icon name="play" /><span class="sr">Film abspielen</span></span>
  </button>
</section>
<style>
  .schluss { position: relative; overflow: hidden; isolation: isolate; background: #050505; border-top: 1px solid var(--linie-dunkel); }
  .schluss-bild, .schluss-film { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .schluss-film { opacity: 0; transition: opacity 1.4s ease; }
  .schluss.spielt .schluss-film { opacity: 1; }
  .schluss-schleier { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 120% at 30% 60%, rgba(10, 10, 10, 0.55), rgba(10, 10, 10, 0.92) 75%); }
  .schluss-inhalt { padding-block: clamp(4.5rem, 11vw, 8rem); }
  .schluss h2 { font-size: clamp(2.4rem, 5.6vw, 4.6rem); max-width: 12em; margin-bottom: 0.6rem; }
  .schluss-unter { margin: 0 0 2rem; font: 400 clamp(1.3rem, 2.4vw, 1.9rem)/1.3 var(--serif); color: #d9d5cd; }
  .erzaehlt { position: relative; display: inline-block; }
  .schluss :global(.schluss-strich) { position: absolute; left: -0.1em; bottom: -0.35em; width: calc(100% + 0.2em); height: 0.45em; color: var(--gelb); }
  .clip-pause { position: absolute; right: 1rem; bottom: 1rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid rgba(243, 241, 236, 0.3); border-radius: 2px; background: rgba(10, 10, 10, 0.5); color: var(--weiss); cursor: pointer; }
  .clip-pause :global(svg) { width: 1.05rem; height: 1.05rem; }
  .clip-pause .p-aus { display: none; }
  .clip-pause[aria-pressed="true"] .p-an { display: none; }
  .clip-pause[aria-pressed="true"] .p-aus { display: grid; }
</style>
