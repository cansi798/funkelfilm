---
// Kopfzeile: Logo, Navigation, ein Hauptknopf. Beim Scrollen nur Schatten + gelbe Fortschrittsleiste (Höhe bleibt).
// Menü am Handy ohne JS (<details>).
import Marke from "./Marke.astro";
import Icon from "./Icon.astro";
import { NAV, u } from "../daten";
const pfad = Astro.url.pathname.replace(/\/?$/, "/");
const aktiv = (href: string) => pfad === u(href) || (href === "/services/" && /\/(imagefilme|erfahrungsberichte|recruitingfilm|veranstaltungsfilm)\/$/.test(pfad));
---
<header class="kopf">
  <div class="huelle kopf-innen">
    <a class="marke" href={u("/")} aria-label="Funkelfilm – Unternehmensfilme aus Hamburg – zur Startseite"><Marke /></a>
    <nav class="nav-breit" aria-label="Hauptnavigation">
      <ul>
        {NAV.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? "page" : undefined}>{n.titel}</a></li>)}
      </ul>
    </nav>
    <a class="knopf kopf-cta" href={u("/kontakt/")}>Kostenloses Erstgespräch</a>
    <details class="nav-schmal">
      <summary><span class="zu"><Icon name="menue" /></span><span class="auf"><Icon name="schliessen" /></span><span class="sr">Menü</span></summary>
      <nav aria-label="Hauptnavigation (mobil)">
        <ul>
          <li><a href={u("/")} aria-current={pfad === u("/") ? "page" : undefined}>Start</a></li>
          {NAV.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? "page" : undefined}>{n.titel}</a></li>)}
          <li><a class="knopf" href={u("/kontakt/")}>Kostenloses Erstgespräch</a></li>
        </ul>
      </nav>
    </details>
  </div>
  <div class="kopf-balken" aria-hidden="true"><span></span></div>
</header>
<style>
  .kopf { position: sticky; top: 0; z-index: 50; background: rgba(10, 10, 10, 0.94); border-bottom: 1px solid var(--linie-dunkel); transition: box-shadow 0.3s ease; }
  .kopf.gescrollt { box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.9); }
  .kopf-innen { display: flex; align-items: center; gap: 1rem; height: var(--kopf-h); }
  .marke { display: block; margin-right: auto; flex: none; }
  .marke :global(.logo) { width: 7.6rem; height: auto; }
  @media (min-width: 40rem) { .marke :global(.logo) { width: 9rem; } }
  @media (min-width: 80rem) { .marke :global(.logo) { width: 10.5rem; } }

  .nav-breit { display: none; }
  .nav-breit ul { list-style: none; display: flex; margin: 0; padding: 0; }
  .nav-breit a { position: relative; display: block; padding: 0.6rem clamp(0.55rem, 0.9vw, 0.85rem); font: 600 0.95rem/1.2 var(--titel); color: var(--silber); transition: color var(--dur-fast) ease; }
  .nav-breit a:hover, .nav-breit a[aria-current="page"] { color: var(--weiss); }
  .nav-breit a[aria-current="page"]::after { content: ""; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0.2rem; height: 2px; background: var(--gelb); }
  .kopf-cta { display: none; min-height: 2.75rem; padding: 0.55rem 1.1rem; font-size: 0.92rem; }

  .nav-schmal summary { list-style: none; display: grid; place-items: center; width: 3rem; height: 3rem; cursor: pointer; border: 1px solid var(--linie-dunkel); border-radius: 2px; }
  .nav-schmal summary::-webkit-details-marker { display: none; }
  .nav-schmal summary :global(svg) { width: 1.5rem; height: 1.5rem; }
  .nav-schmal .auf { display: none; }
  .nav-schmal[open] .auf { display: block; }
  .nav-schmal[open] .zu { display: none; }
  .nav-schmal nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--nacht); border-bottom: 1px solid var(--linie-dunkel); padding: 0.5rem var(--rand) 1.5rem; }
  .nav-schmal ul { list-style: none; margin: 0; padding: 0; }
  .nav-schmal li a:not(.knopf) { display: block; padding: 0.9rem 0; border-bottom: 1px solid var(--linie-dunkel); font: 600 1.15rem/1.3 var(--titel); }
  .nav-schmal li a[aria-current="page"]:not(.knopf) { color: var(--gelb); }
  .nav-schmal .knopf { margin-top: 1.25rem; width: 100%; }

  /* Mit Logo-Unterzeile ist es enger: volle Navigation erst ab 72rem, darunter Menü-Knopf (+ Hauptknopf ab 48rem) */
  .nav-breit a, .kopf-cta { white-space: nowrap; }
  @media (min-width: 48rem) { .kopf-cta { display: inline-flex; } }
  @media (min-width: 72rem) {
    .nav-breit { display: block; }
    .nav-schmal { display: none; }
  }
  .kopf-balken { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .kopf-balken span { display: block; height: 100%; background: var(--gelb); transform: scaleX(0); transform-origin: left; }
</style>
