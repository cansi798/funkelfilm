---
// „Aus Hamburg. Drehs in ganz Deutschland.“ (Can Talk 4242): handgezeichnete Deutschland-Karte seit 07.11. in Gelb auf Anthrazit (davor Gold/Bronze auf Schwarz).
// Sie zeichnet sich einmal, sobald sie gut im Bild ist: Umriss → Hamburg → Städte → Reisebögen zu allen 12 Städten nacheinander, die genau an den Punkten enden (~3 s; Jamil 4251).
// Ohne JS und bei reduzierter Bewegung: fertige Karte. SEO ehrlich: Städte als echter Text (SVG-Text im HTML + Satz), Einsatzgebiet im
// JSON-LD (Basis.astro) – keine Stadt-Unterseiten, keine Keyword-Listen. Breit: Karte links, Text rechts (Mensch davor ist Text links).
import { deutschlandKarte, KARTE } from "../lib/karte";
import { EINSATZ, u } from "../daten";
const k = deutschlandKarte();
// Beschriftung je Seite: Versatz x, y und Ausrichtung (passend zu den Prüfboxen im Suchskript)
const lage: Record<string, [number, number, string]> = { r: [8, 5, "start"], l: [-8, 5, "end"], u: [0, 20, "middle"], o: [0, -11, "middle"], ur: [5, -11, "start"], ul: [-5, -11, "end"], dr: [5, 20, "start"], dl: [-5, 20, "end"] };
const stufe = (i: number) => `o${Math.min(3, Math.floor(i / 3))}`;
---
<section class="abschnitt kompakt einsatz dunkel" aria-labelledby="einsatz-titel">
  <div class="huelle einsatz-raster">
    <div class="einsatz-text">
      <h2 id="einsatz-titel">{EINSATZ.titel}</h2>
      <p class="gross">{EINSATZ.text}</p>
      <p>{EINSATZ.anreise}</p>
      <a class="weiter" href={u("/kontakt/")}>Erstgespräch vereinbaren</a>
    </div>
    <div class="karte" data-skizze="sichtbar">
      <svg viewBox={`0 0 ${KARTE.breite} ${KARTE.hoehe}`} width={KARTE.breite} height={KARTE.hoehe} role="img" aria-labelledby="karte-titel">
        <title id="karte-titel">Skizze: Deutschland-Karte mit Hamburg als Standort und Städten in ganz Deutschland</title>
        {k.umriss.map((d) => <path class="k-umriss" d={d} pathLength="1" />)}
        {k.boegen.map((b) => <path class={`k-bogen b${b.nr}`} d={b.d} pathLength="1" />)}
        {k.orte.map((o, i) => (
          <g class={`k-ort ${stufe(i)}`}>
            <circle cx={o.x} cy={o.y} r={k.rOrt} />
            <text x={o.x + lage[o.seite][0]} y={o.y + lage[o.seite][1]} text-anchor={lage[o.seite][2]}>{o.name}</text>
          </g>
        ))}
        <g class="k-heimat">
          <circle class="k-ring" cx={k.heimat.x} cy={k.heimat.y} r={k.heimat.r} />
          <circle class="k-kern" cx={k.heimat.x} cy={k.heimat.y} r="5.5" />
          <text x={k.heimat.x + 16} y={k.heimat.y + 6}>{k.heimat.name}</text>
        </g>
      </svg>
    </div>
  </div>
</section>
<style>
  .einsatz-raster { display: grid; gap: 1.75rem; justify-items: center; }
  .einsatz-text { width: 100%; max-width: 36rem; }
  .einsatz-text h2 { margin-bottom: 0.9rem; }
  .einsatz-text p { margin-bottom: 0.8rem; }
  .einsatz-text .gross { font: 600 clamp(1.25rem, 2vw, 1.6rem)/1.3 var(--serif); color: var(--tinte); }
  .karte { width: min(21rem, 88vw); }
  .karte svg { width: 100%; height: auto; overflow: visible; }
  @media (min-width: 60rem) {
    .einsatz-raster { grid-template-columns: auto minmax(0, 34rem); justify-content: center; align-items: center; gap: clamp(3rem, 7vw, 6rem); }
    .karte { order: -1; width: 23rem; }
  }
  .k-umriss { fill: none; stroke: var(--akzent-linie); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .k-bogen { fill: none; stroke: rgba(255, 204, 0, 0.45); stroke-width: 1.8; stroke-linecap: round; }
  .k-ort circle { fill: var(--tinte); }
  /* dunkler Rand um die Schrift: Umriss/Bögen laufen nie sichtbar durch Text (Jamil 4228) */
  .karte text { paint-order: stroke; stroke: var(--grund); stroke-width: 6px; stroke-linejoin: round; }
  .k-ort text { font: 500 15px/1 var(--text); fill: var(--tinte); }
  .k-ring { fill: none; stroke: var(--akzent-linie); stroke-width: 1.8; }
  .k-kern { fill: var(--akzent-linie); }
  .k-heimat text { font: 700 19px/1 var(--serif); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--akzent-text); }

  /* Zeichnen (eine CSS-Uhr): Umriss 0–1 s → Hamburg 0,5 s → Städte 0,7–1,1 s (Text erscheint mit seinem Punkt) → Bögen 1,0–2,9 s, kurze zuerst */
  :global(.js) .karte path { stroke-dasharray: 1 1; stroke-dashoffset: 1; }
  :global(.js) .karte .k-ort, :global(.js) .karte .k-heimat { opacity: 0; }
  :global(.js) .karte.an path { stroke-dashoffset: 0; transition: stroke-dashoffset 1s cubic-bezier(0.45, 0, 0.25, 1); }
  :global(.js) .karte.an .k-bogen { transition-duration: 0.6s; }
  :global(.js) .karte.an .b0 { transition-delay: 1.00s; }
  :global(.js) .karte.an .b1 { transition-delay: 1.12s; }
  :global(.js) .karte.an .b2 { transition-delay: 1.24s; }
  :global(.js) .karte.an .b3 { transition-delay: 1.36s; }
  :global(.js) .karte.an .b4 { transition-delay: 1.48s; }
  :global(.js) .karte.an .b5 { transition-delay: 1.60s; }
  :global(.js) .karte.an .b6 { transition-delay: 1.72s; }
  :global(.js) .karte.an .b7 { transition-delay: 1.84s; }
  :global(.js) .karte.an .b8 { transition-delay: 1.96s; }
  :global(.js) .karte.an .b9 { transition-delay: 2.08s; }
  :global(.js) .karte.an .b10 { transition-delay: 2.20s; }
  :global(.js) .karte.an .b11 { transition-delay: 2.32s; }
  :global(.js) .karte.an .k-ort, :global(.js) .karte.an .k-heimat { opacity: 1; transition: opacity 0.35s ease 0.5s; }
  :global(.js) .karte.an .o0 { transition-delay: 0.7s; }
  :global(.js) .karte.an .o1 { transition-delay: 0.8s; }
  :global(.js) .karte.an .o2 { transition-delay: 0.9s; }
  :global(.js) .karte.an .o3 { transition-delay: 1s; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .karte path { stroke-dasharray: none; stroke-dashoffset: 0; transition: none !important; }
    :global(.js) .karte .k-ort, :global(.js) .karte .k-heimat { opacity: 1; transition: none !important; }
  }
</style>
