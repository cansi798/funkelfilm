---
// Vier Filmarten. Karte = Standbild aus echtem Projekt; beim Darüberfahren (Maus) bzw. Tastatur-Fokus läuft der stumme Ausschnitt.
import { LEISTUNGEN, u } from "../daten";
---
<ul class="karten">
  {LEISTUNGEN.map((l) => (
    <li class="karte reveal">
      <div class="karte-bild" data-vorschau>
        <img src={u(l.clip.poster)} width={l.clip.breite} height={l.clip.hoehe} alt="" loading="lazy" decoding="async" />
        <video muted loop playsinline preload="none" data-src={u(l.clip.datei)} aria-hidden="true" tabindex="-1"></video>
      </div>
      <h3><a href={u(`/${l.slug}/`)}>{l.titel}</a></h3>
      <p>{l.kurz}</p>
      <span class="karte-mehr" aria-hidden="true">Mehr erfahren</span>
    </li>
  ))}
</ul>
<style>
  .karten { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .karten { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 72rem) { .karten { grid-template-columns: repeat(4, 1fr); } }
  .karte { position: relative; display: flex; flex-direction: column; }
  .karte-bild { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--schwarz); margin-bottom: 1.1rem; }
  .karte-bild img, .karte-bild video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.4s ease; }
  .karte-bild video { opacity: 0; }
  .karte-bild.spielt video { opacity: 1; }
  .karte:hover .karte-bild img, .karte:hover .karte-bild video { transform: scale(1.03); }
  .karte-bild::before, .karte-bild::after { content: ""; position: absolute; z-index: 2; width: 1rem; height: 1rem; border: 0 solid var(--gelb); opacity: 0; transition: opacity var(--dur-fast) ease; }
  .karte-bild::before { left: 0.6rem; top: 0.6rem; border-left-width: 2px; border-top-width: 2px; }
  .karte-bild::after { right: 0.6rem; bottom: 0.6rem; border-right-width: 2px; border-bottom-width: 2px; }
  .karte:hover .karte-bild::before, .karte:hover .karte-bild::after, .karte:focus-within .karte-bild::before, .karte:focus-within .karte-bild::after { opacity: 1; }
  .karte h3 { margin: 0 0 0.5rem; }
  .karte h3 a::after { content: ""; position: absolute; inset: 0; z-index: 3; }
  .karte p { color: var(--silber); margin: 0 0 0.9rem; flex: 1; }
  .karte-mehr { font: 600 0.95rem/1.3 var(--titel); color: var(--gelb); }
  .karte:hover .karte-mehr { text-decoration: underline; text-decoration-thickness: 2px; }
  .karte:focus-within { outline: 2px solid var(--gelb); outline-offset: 6px; }
  .karte h3 a:focus-visible { outline: none; }
  @media (prefers-reduced-motion: reduce) { .karte-bild img, .karte-bild video { transition: none; } .karte:hover .karte-bild img { transform: none; } }
</style>
