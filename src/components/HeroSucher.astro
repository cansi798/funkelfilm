---
// Signature-Element „Sucher“: echte Ausschnitte aus Funkelfilm-Projekten im Kamerasucher.
// Beim Ankommen zieht die Schärfe (Fokus) in ca. 1,2 s auf, die Sucher-Ecken rasten ein, REC leuchtet, der Timecode läuft mit dem Film.
// Ohne JS bzw. bei reduzierter Bewegung: scharfes Standbild, kein Autoplay. Das Video lädt erst nach dem Seitenaufbau (Ladezeit).
import { CLAIM, UNTERZEILE, u } from "../daten";
import Icon from "./Icon.astro";
import Skizze from "./Skizze.astro";
const [satz1, satz2] = CLAIM.split(". ");
const poster = u("/medien/clips/reel.webp");
const posterKlein = u("/medien/clips/reel-640.webp");
---
<section class="hero" aria-labelledby="hero-titel">
  <div class="huelle hero-raster">
    <h1 id="hero-titel" class="hero-titel"><span>{satz1}. </span><span class="kern">{satz2}<Skizze form="unterstrich" breite={420} hoehe={26} klasse="kern-strich" nachIntro dick /></span></h1>
    <p class="hero-unter lead">{UNTERZEILE}</p>
    <figure class="sucher" data-sucher>
      <div class="sucher-bild">
        <img class="sucher-poster" src={poster} srcset={`${posterKlein} 640w, ${poster} 1280w`} sizes="(min-width: 64rem) 44rem, 100vw" width="1280" height="720" alt="" fetchpriority="high" decoding="async" />
        <video class="sucher-video" muted loop playsinline preload="none" data-src={u("/medien/clips/reel.mp4")} aria-hidden="true" tabindex="-1" width="1280" height="720"></video>
      </div>
      <div class="sucher-rahmen" aria-hidden="true">
        <span class="ecke e1"></span><span class="ecke e2"></span><span class="ecke e3"></span><span class="ecke e4"></span>
        <span class="fokus"></span>
        <span class="rec"><i></i>REC</span>
        <span class="zeit" data-zeit>00:00:00:00</span>
      </div>
      <button class="sucher-pause" type="button" data-pause hidden aria-pressed="false">
        <span class="p-an"><Icon name="pause" /><span class="sr">Film anhalten</span></span>
        <span class="p-aus"><Icon name="play" /><span class="sr">Film abspielen</span></span>
      </button>
      <figcaption class="sr">Ausschnitte aus Projekten von Funkelfilm (Imagefilm, Kundenstimme, Event)</figcaption>
    </figure>
    <div class="hero-knoepfe knoepfe">
      <a class="knopf" href={u("/kontakt/")}>Kostenloses Erstgespräch</a>
      <a class="knopf rahmen" href={u("/erfolgsgeschichten/")}>Projekte ansehen</a>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3.5rem, 6vw, 4.5rem); overflow: hidden;
    background: radial-gradient(120% 90% at 78% 40%, #15153a 0%, var(--nacht) 58%); }
  .hero-raster { display: grid; gap: 1.25rem 0; grid-template-areas: "titel" "unter" "sucher" "knoepfe"; align-items: start; }
  .hero-titel { grid-area: titel; margin: 0; max-width: 11em; }
  .kern { position: relative; display: inline-block; }
  .hero-titel :global(.kern-strich) { position: absolute; left: -0.1em; right: -0.05em; bottom: -0.2em; width: calc(100% + 0.15em); height: 0.32em; }
  .hero-unter { grid-area: unter; margin: 0; color: var(--silber); max-width: 26em; }
  .hero-knoepfe { grid-area: knoepfe; }
  .sucher { grid-area: sucher; margin: 0.75rem 0 0.5rem; position: relative; }
  @media (min-width: 64rem) {
    .hero-raster { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); column-gap: clamp(2.5rem, 5vw, 4.5rem);
      grid-template-areas: "titel sucher" "unter sucher" "knoepfe sucher"; grid-template-rows: 1fr auto 1fr; align-items: center; }
    .hero-titel { font-size: clamp(2.5rem, 3.45vw, 3.4rem); max-width: none; }
    .hero-titel span { display: block; white-space: nowrap; }
    .hero-titel span.kern { display: inline-block; }
    .hero-titel { align-self: end; }
    .hero-knoepfe { align-self: start; margin-top: 0.75rem; }
    .sucher { margin: 0; }
  }

  /* Sucher */
  .sucher-bild { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--schwarz); }
  .sucher-poster, .sucher-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sucher-video { opacity: 0; transition: opacity 600ms ease; }
  .sucher.laeuft .sucher-video { opacity: 1; }
  .sucher-bild::after { content: ""; position: absolute; inset: 0; background: radial-gradient(90% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.55) 100%); pointer-events: none; }
  .sucher-rahmen { position: absolute; inset: 0; pointer-events: none; color: var(--weiss); font: 600 0.78rem/1 var(--titel); font-variant-numeric: tabular-nums; }
  .ecke { position: absolute; width: clamp(1.25rem, 3.4vw, 2.25rem); height: clamp(1.25rem, 3.4vw, 2.25rem); border: 0 solid rgba(255, 255, 255, 0.9); }
  .e1 { left: 0.9rem; top: 0.9rem; border-left-width: 2px; border-top-width: 2px; }
  .e2 { right: 0.9rem; top: 0.9rem; border-right-width: 2px; border-top-width: 2px; }
  .e3 { left: 0.9rem; bottom: 0.9rem; border-left-width: 2px; border-bottom-width: 2px; }
  .e4 { right: 0.9rem; bottom: 0.9rem; border-right-width: 2px; border-bottom-width: 2px; }
  .fokus { position: absolute; left: 50%; top: 50%; width: 18%; aspect-ratio: 1; translate: -50% -50%; border: 1.5px solid var(--gelb); opacity: 0; }
  .rec { position: absolute; left: 2.1rem; top: 1.6rem; display: flex; align-items: center; gap: 0.4rem; letter-spacing: 0.04em; }
  .rec i { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--gelb); box-shadow: 0 0 10px 2px rgba(255, 204, 0, 0.55); }
  .zeit { position: absolute; right: 2.1rem; top: 1.6rem; letter-spacing: 0.04em; }
  @media (max-width: 30rem) { .rec { left: 1.6rem; top: 1.3rem; } .zeit { right: 1.6rem; top: 1.3rem; } }

  /* Ankommen: Schärfe zieht auf, Ecken rasten ein, Fokusfeld schließt sich (alles ≤ 1,4 s, eine Uhr: CSS) */
  :global(.js) .sucher .sucher-poster { filter: blur(10px); transform: scale(1.05); }
  :global(.js) .sucher .ecke { opacity: 0.35; }
  :global(.js) .sucher .e1 { transform: translate(-14px, -14px); }
  :global(.js) .sucher .e2 { transform: translate(14px, -14px); }
  :global(.js) .sucher .e3 { transform: translate(-14px, 14px); }
  :global(.js) .sucher .e4 { transform: translate(14px, 14px); }
  :global(.js) .sucher .rec, :global(.js) .sucher .zeit { opacity: 0; }
  :global(.js) .sucher.an .sucher-poster { filter: none; transform: none; transition: filter 1.1s var(--ease) 0.1s, transform 1.2s var(--ease); }
  :global(.js) .sucher.an .ecke { opacity: 1; transform: none; transition: transform 0.9s var(--ease) 0.15s, opacity 0.9s ease 0.15s; }
  :global(.js) .sucher.an .rec, :global(.js) .sucher.an .zeit { opacity: 1; transition: opacity 0.4s ease 0.9s; }
  :global(.js) .sucher.an .fokus { animation: fokus 1.3s var(--ease) 0.1s both; }
  :global(.js) .sucher.an .rec i { animation: blinken 1.6s steps(2, jump-none) 1.3s infinite; }
  .sucher.pausiert .rec i { animation: none !important; opacity: 0.35; }
  @keyframes fokus { 0% { opacity: 0; scale: 2.4; } 25% { opacity: 1; } 70% { opacity: 1; scale: 1; } 100% { opacity: 0; scale: 1; } }
  @keyframes blinken { 0% { opacity: 1; } 100% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .sucher .sucher-poster, :global(.js) .sucher .ecke, :global(.js) .sucher .rec, :global(.js) .sucher .zeit { filter: none !important; transform: none !important; opacity: 1 !important; transition: none !important; }
    :global(.js) .sucher .fokus, :global(.js) .sucher .rec i { animation: none !important; }
  }

  .sucher-pause { position: absolute; right: 0.9rem; bottom: -3.4rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--linie-dunkel); border-radius: 2px; background: transparent; color: var(--weiss); cursor: pointer; }
  .sucher-pause:hover { border-color: var(--gelb); }
  .sucher-pause :global(svg) { width: 1.1rem; height: 1.1rem; }
  .sucher-pause .p-aus { display: none; }
  .sucher-pause[aria-pressed="true"] .p-an { display: none; }
  .sucher-pause[aria-pressed="true"] .p-aus { display: grid; }
  @media (max-width: 63.99rem) { .sucher-pause { bottom: auto; top: calc(100% + 0.6rem); } .hero-knoepfe { padding-right: 3.5rem; } }
</style>
