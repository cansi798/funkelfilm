---
// „Hinter jedem Film steht ein Mensch.“ (Jamil 4226): Text links, Porträt rund ausgeschnitten rechts, beides vertikal zentriert.
// Am Handy: rundes Porträt mittig über dem Text. B-Roll entfernt, damit es ruhig bleibt.
import Bild from "./Bild.astro";
import { MENSCH, u } from "../daten";
---
<section class="abschnitt kompakt mensch" aria-labelledby="mensch-titel">
  <div class="huelle mensch-raster">
    <div class="mensch-text">
      <h2 id="mensch-titel">{MENSCH.titel}</h2>
      {MENSCH.zeilen.map((z, i) => <p class:list={{ gross: i === 0 }}>{z}</p>)}
      <a class="weiter" href={u("/about/")}>Mehr über Sheeras</a>
    </div>
    <div class="mensch-bild reveal">
      <Bild name="sheeras" breiten={[400, 640]} sizes="(min-width: 60rem) 21rem, 13rem" verhaeltnis={[4, 5]} alt="Sheeras Iqbal, Filmemacher und Gründer von Funkelfilm (Schwarz-Weiß-Porträt)" />
    </div>
  </div>
</section>
<style>
  .mensch-raster { display: grid; gap: 1.75rem; justify-items: center; }
  .mensch-bild { order: -1; width: min(13rem, 60vw); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--nacht-2);
    box-shadow: 0 0 0 1px rgba(141, 110, 77, 0.7), 0 0 0 10px var(--nacht), 0 0 0 11px rgba(141, 110, 77, 0.35); }
  .mensch-bild :global(picture), .mensch-bild :global(img) { display: block; width: 100%; height: 100%; }
  .mensch-bild :global(img) { object-fit: cover; object-position: 50% 28%; filter: grayscale(1); }
  .mensch-text { width: 100%; max-width: 38rem; }
  .mensch-text h2 { margin-bottom: 0.9rem; }
  .mensch-text p { margin-bottom: 0.8rem; }
  .mensch-text .gross { font: 600 clamp(1.4rem, 2.2vw, 1.8rem)/1.25 var(--serif); color: var(--weiss); }
  @media (min-width: 60rem) {
    .mensch-raster { grid-template-columns: minmax(0, 36rem) auto; justify-content: center; align-items: center; justify-items: start; gap: clamp(3rem, 7vw, 6rem); }
    .mensch-bild { order: 0; width: 21rem; }
  }
</style>
