---
// Regieskizze im Hero (Can 02.11.2026: „Hero mit Rough.js wow … hier entstehen Filme“).
// Nach dem Einstieg zeichnet sich in Gold ein Storyboard-Rahmen mit Kadrier-Marken um den laufenden Film,
// darunter eine kleine Filmklappe: Tafel, Klappe schnappt zu, „Take 1“ erscheint. Ablauf ca. 2,3 s, einmal.
// Ruhig nach Jamil 4228/4230: Einzelstrich, Rauheit 0,25–0,5, nichts berührt Text (eigene Spalte bzw. Filmfläche).
// rough.js nur beim Build (src/lib/skizze.ts), im Browser nur statisches SVG + CSS. Ohne JS und bei reduzierter Bewegung: fertiges Bild.
import { storyboard, filmklappe } from "../lib/skizze";
const breit = storyboard(640, 360, 41);
const schmal = storyboard(600, 358, 43);
const k = filmklappe(61);
---
<div class="regie" aria-hidden="true" data-skizze="hero">
  <svg class="regie-rahmen r-breit" viewBox="0 0 640 360" preserveAspectRatio="none" focusable="false">
    {breit.rahmen.map((p) => <path class="z-rahmen" d={p.d} pathLength="1" />)}
    {breit.marken.map((p, i) => <path class={`z-marke m${i % 2}`} d={p.d} pathLength="1" />)}
    {breit.kreuz.map((p) => <path class="z-kreuz" d={p.d} pathLength="1" />)}
  </svg>
  <svg class="regie-rahmen r-schmal" viewBox="0 0 600 358" preserveAspectRatio="none" focusable="false">
    {schmal.rahmen.map((p) => <path class="z-rahmen" d={p.d} pathLength="1" />)}
    {schmal.marken.map((p, i) => <path class={`z-marke m${i % 2}`} d={p.d} pathLength="1" />)}
    {schmal.kreuz.map((p) => <path class="z-kreuz" d={p.d} pathLength="1" />)}
  </svg>
  <svg class="regie-klappe" viewBox="0 0 120 104" focusable="false">
    <g class="k-tafel">{k.tafel.map((p) => <path d={p.d} pathLength="1" />)}</g>
    <g class="k-balken">{k.balken.map((p) => <path d={p.d} pathLength="1" />)}</g>
    <g class="k-arm">{k.klappe.map((p) => <path d={p.d} pathLength="1" />)}</g>
    <text class="k-take" x="60" y="90" text-anchor="middle">TAKE 1</text>
  </svg>
</div>
<style>
  .regie { pointer-events: none; color: var(--gelb); }
  .regie svg { display: block; max-width: none; overflow: visible; }
  .regie path { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .regie-rahmen path { stroke-width: 2; }
  .regie-klappe path { stroke-width: 2.4; }
  .k-take { fill: currentColor; font: 700 25px/1 var(--serif); letter-spacing: 0.08em; }
  .k-arm { transform-box: view-box; transform-origin: 6px 28px; }

  /* Handy/Tablet: Film oben (16:10), Rahmen liegt 14 px innen auf dem Film, Klappe in der Ecke unten rechts */
  .regie { position: absolute; left: 0; right: 0; top: 0; aspect-ratio: 16 / 10; }
  .r-breit { display: none !important; }
  .r-schmal { position: absolute; inset: 0.875rem; width: calc(100% - 1.75rem); height: calc(100% - 1.75rem); }
  .regie-klappe { position: absolute; right: 1.75rem; bottom: 1.75rem; width: clamp(3.9rem, 15vw, 5.5rem); height: auto; }

  /* Breit: eigene rechte Spalte neben dem Text, Rahmen 16:9 über dem Film, Klappe darunter rechtsbündig */
  @media (min-width: 60rem) {
    .regie { position: relative; aspect-ratio: auto; width: 100%; max-width: 34rem; justify-self: end; align-self: center; }
    .r-schmal { display: none !important; }
    .r-breit { display: block !important; width: 100%; height: auto; aspect-ratio: 16 / 9; }
    .regie-klappe { position: relative; right: auto; bottom: auto; margin: 1.1rem 0 0 auto; width: 6.25rem; }
  }

  /* Zeichnen: Rahmen → Kadrier-Marken → Mittelkreuz → Filmklappe → Klappe schnappt zu → „Take 1“ (eine CSS-Uhr) */
  :global(.js) .regie path { stroke-dasharray: 1 1; stroke-dashoffset: 1; }
  :global(.js) .regie .k-arm { transform: rotate(-24deg); }
  :global(.js) .regie .k-take { opacity: 0; }
  :global(.js) .regie.an path { stroke-dashoffset: 0; transition: stroke-dashoffset 0.3s cubic-bezier(0.45, 0, 0.25, 1); }
  :global(.js) .regie.an .z-rahmen { transition-duration: 0.95s; }
  :global(.js) .regie.an .m0 { transition-delay: 0.8s; }
  :global(.js) .regie.an .m1 { transition-delay: 0.92s; }
  :global(.js) .regie.an .z-kreuz { transition-duration: 0.22s; transition-delay: 1.05s; }
  :global(.js) .regie.an .k-tafel path { transition-duration: 0.45s; transition-delay: 1.15s; }
  :global(.js) .regie.an .k-balken path, :global(.js) .regie.an .k-arm path { transition-delay: 1.42s; }
  :global(.js) .regie.an .k-arm { transform: none; transition: transform 0.17s cubic-bezier(0.7, 0, 1, 0.55) 1.85s; }
  :global(.js) .regie.an .k-take { opacity: 1; transition: opacity 0.35s ease 2.02s; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .regie path { stroke-dasharray: none; stroke-dashoffset: 0; transition: none !important; }
    :global(.js) .regie .k-arm { transform: none; transition: none !important; }
    :global(.js) .regie .k-take { opacity: 1; transition: none !important; }
  }
</style>
