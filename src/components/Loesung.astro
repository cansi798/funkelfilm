---
// „Menschen vertrauen Menschen.“ – Überschrift und vier Punkte (Jamil 4227: Vergleich ohne/mit Film entfernt).
import { LOESUNG } from "../daten";
---
<section class="abschnitt kompakt loesung" aria-labelledby="loesung-titel">
  <div class="huelle loesung-raster">
    <div class="loesung-text">
      <h2 id="loesung-titel">{LOESUNG.titel}</h2>
      <p>{LOESUNG.text}</p>
    </div>
    <ul class="haken">
      {LOESUNG.punkte.map((p) => <li class="reveal"><span class="haken-icon" aria-hidden="true"></span>{p}</li>)}
    </ul>
  </div>
</section>
<style>
  .loesung-raster { display: grid; gap: 1.25rem clamp(2rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 60rem) { .loesung-raster { grid-template-columns: 1fr 1fr; } }
  .loesung-text h2 { margin-bottom: 0.7rem; }
  .loesung-text p { margin: 0; font-size: 1.1rem; }
  .haken { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 40rem) and (max-width: 59.99rem) { .haken { grid-template-columns: 1fr 1fr; } }
  .haken li { display: flex; align-items: center; gap: 0.85rem; padding: 0.95rem 1.1rem; background: var(--nacht-2); border-radius: 3px; color: var(--weiss); font-size: 1.08rem; }
  .haken-icon { flex: none; width: 1.5rem; height: 1.5rem; border: 1.5px solid var(--gelb); border-radius: 50%; position: relative; }
  .haken-icon::after { content: ""; position: absolute; left: 0.45rem; top: 0.22rem; width: 0.38rem; height: 0.7rem; border: solid var(--gelb); border-width: 0 2px 2px 0; transform: rotate(45deg); }
</style>
