---
// Logo mit fester Unterzeile (Can 02.11.2026; Text seit Jamil 4345: „Echte Geschichten.“, einzeilig). Das Logo-PNG bleibt unverändert;
// die Unterzeile steht als Text daneben – Barlow Condensed in Versalien mit Laufweite, wie die Logo-Buchstaben, getrennt durch eine
// feine Linie. Ein- oder zweizeilig je nach Text, am Handy lesbar (≥ 11 px). Als festen Logo-Bestandteil mit Funkelfilm abstimmen (OFFENE-INFOS 5).
import Logo from "./Logo.astro";
import { LOGO_UNTERZEILE } from "../daten";
interface Props { klasse?: string; }
const { klasse = "" } = Astro.props;
---
<span class:list={["marke-sperre", klasse]}>
  <Logo />
  <span class="marke-unter">{LOGO_UNTERZEILE.map((z, i) => <>{i > 0 && <br />}{z}</>)}</span>
</span>
<style>
  .marke-sperre { display: inline-flex; align-items: center; gap: 0.7rem; }
  .marke-unter { padding-left: 0.7rem; border-left: 1px solid var(--linie-mittel);
    font: 600 0.72rem/1.15 var(--serif); letter-spacing: 0.16em; text-transform: uppercase; color: var(--tinte-leise); white-space: nowrap; }
  @media (min-width: 40rem) { .marke-unter { font-size: 0.8rem; } }
</style>
