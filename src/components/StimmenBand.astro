---
// Kundenstimmen als langsamer horizontaler Lauf (Jamils Konzept). Nur die fünf echten Stimmen der bisherigen Seite, wörtlich, ohne Sterne
// (es gibt keine belegte Bewertungsquelle). Hält beim Darüberfahren/Fokus an, Pause-Knopf; bei reduzierter Bewegung wischbare Reihe ohne Lauf.
import Icon from "./Icon.astro";
import { STIMMEN, u } from "../daten";
const liste = STIMMEN;
---
<section class="abschnitt kompakt stimmen-band" aria-labelledby="stimmen-titel">
  <div class="huelle kopfzeile-zeile">
    <h2 id="stimmen-titel">Das sagen unsere Kunden.</h2>
    <div class="band-steuer">
      <button class="band-pause" type="button" data-band-pause aria-pressed="false">
        <span class="p-an"><Icon name="pause" /><span class="sr">Laufband anhalten</span></span>
        <span class="p-aus"><Icon name="play" /><span class="sr">Laufband starten</span></span>
      </button>
      <a class="weiter" href={u("/erfolgsgeschichten/#stimmen")}>Alle Stimmen</a>
    </div>
  </div>
  <div class="band-fenster" data-band>
    <ul class="band-spur">
      {[0, 1].map((kopie) => liste.map((s) => (
        <li class="band-stimme" aria-hidden={kopie === 1 ? "true" : undefined}>
          <blockquote><p>„{s.kurz}“</p></blockquote>
          <p class="wer"><strong>{s.name}</strong><span>{s.firma}</span></p>
        </li>
      )))}
    </ul>
  </div>
</section>
<style>
  .kopfzeile-zeile h2 { margin: 0; }
  .band-steuer { display: flex; align-items: center; gap: 1rem; }
  .band-pause { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--linie-dunkel); border-radius: 2px; background: transparent; color: var(--weiss); cursor: pointer; }
  .band-pause:hover { border-color: var(--bronze); }
  .band-pause :global(svg) { width: 1rem; height: 1rem; }
  .band-pause .p-aus { display: none; }
  .band-pause[aria-pressed="true"] .p-an { display: none; }
  .band-pause[aria-pressed="true"] .p-aus { display: grid; }
  .band-fenster { overflow: hidden; -webkit-mask: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .band-spur { list-style: none; margin: 0; padding: 0.25rem 0; display: flex; gap: 1.25rem; width: max-content; animation: lauf 80s linear infinite; }
  .band-fenster:hover .band-spur, .band-fenster:focus-within .band-spur, .band-fenster.halt .band-spur { animation-play-state: paused; }
  @keyframes lauf { to { transform: translateX(calc(-50% - 0.625rem)); } }
  .band-stimme { flex: none; width: min(78vw, 24rem); padding: 1.2rem 1.35rem; background: var(--nacht-2); border-left: 2px solid var(--gelb); border-radius: 2px; display: flex; flex-direction: column; justify-content: space-between; }
  blockquote { margin: 0 0 1rem; }
  blockquote p { margin: 0; font: 400 clamp(1.2rem, 1.6vw, 1.4rem)/1.3 var(--serif); color: var(--weiss); }
  .wer { margin: 0; font-size: 0.92rem; display: grid; }
  .wer strong { color: var(--weiss); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    .band-spur { animation: none; }
    .band-fenster { overflow-x: auto; scroll-snap-type: x mandatory; }
    .band-stimme { scroll-snap-align: start; }
    .band-stimme[aria-hidden="true"] { display: none; }
    .band-pause { display: none; }
  }
</style>
