---
// Kundenstimmen wörtlich von funkelfilm.com. kurz = wörtlicher Auszug, voll = ganzer Text.
import { STIMMEN } from "../daten";
interface Props { anzahl?: number; voll?: boolean; reihe?: boolean; }
const { anzahl = STIMMEN.length, voll = false, reihe = false } = Astro.props;
const liste = STIMMEN.slice(0, anzahl);
---
<ul class:list={["stimmen", { voll, reihe }]}>
  {liste.map((s) => (
    <li class="stimme reveal">
      <blockquote>
        <p>„{voll ? s.text : s.kurz}“</p>
      </blockquote>
      <p class="wer"><strong>{s.name}</strong><span>{s.firma}</span></p>
    </li>
  ))}
</ul>
<style>
  .stimmen { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1.25rem, 3vw, 2rem); }
  @media (min-width: 56rem) { .stimmen:not(.voll) { grid-template-columns: repeat(3, 1fr); } .stimmen.voll { grid-template-columns: 1fr 1fr; } }
  /* Reihe: am Handy wischbar statt untereinander (weniger Scrollen) */
  @media (max-width: 55.99rem) {
    .reihe { grid-auto-flow: column; grid-auto-columns: 84%; overflow-x: auto; scroll-snap-type: x mandatory; margin-right: calc(-1 * var(--rand)); padding-right: var(--rand); padding-bottom: 0.4rem; scrollbar-width: none; }
    .reihe > li { scroll-snap-align: start; }
  }
  .reihe .stimme { background: var(--nacht-2); border: 1px solid var(--linie-dunkel); border-left: 4px solid var(--gelb); }
  .reihe blockquote p { color: var(--weiss); }
  .reihe .wer span { color: var(--silber); }
  .stimme { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.4rem, 3vw, 2rem); background: var(--nacht-2); border-left: 2px solid var(--gelb); }
  blockquote { margin: 0 0 1.25rem; }
  blockquote p { margin: 0; font: 400 clamp(1.25rem, 1.8vw, 1.5rem)/1.35 var(--serif); color: var(--weiss); }
  .voll blockquote p { font: 400 1.05rem/1.7 var(--text); }
  .wer { margin: 0; display: grid; gap: 0.1rem; }
  .wer strong { font: 600 1rem/1.3 var(--titel); }
  .wer span { color: var(--silber); font-size: 0.95rem; }
  .wer strong { color: var(--weiss); }
</style>
