---
// Anrufen + WhatsApp (Jamil Talk 4244). Nummer zentral in daten.ts (TELEFON/WHATSAPP).
// Ohne Nummer: in der Vorschau rot gestrichelte Knöpfe „Nummer folgt“ ohne Link; live gar nicht sichtbar.
// WhatsApp öffnet die App bzw. wa.me – erst dann gehen Daten an WhatsApp (Meta); Hinweis als Titel/Text + Datenschutzseite.
// Varianten: "knoepfe" (Kontakt, Schluss), "menue" (mobiles Menü), "leiste" (feste Leiste am Handy).
import Icon from "./Icon.astro";
import { TELEFON, TELEFON_LINK, WHATSAPP_LINK, VORSCHAU } from "../daten";
interface Props { art?: "knoepfe" | "menue" | "leiste"; hinweis?: boolean; }
const { art = "knoepfe", hinweis = false } = Astro.props;
const zeigen = !!TELEFON || VORSCHAU;
const waTitel = "WhatsApp öffnet sich – dabei gelten die Datenschutzregeln von WhatsApp (Meta)";
---
{zeigen && (
  <div class:list={["dk", `dk-${art}`, { offen: !TELEFON, dunkel: art === "leiste" }]} data-direkt={art === "leiste" ? "" : undefined}>
    {TELEFON_LINK
      ? <a class="dk-knopf" href={TELEFON_LINK} aria-label={`Funkelfilm anrufen: ${TELEFON}`}><Icon name="telefon" /><span>Anrufen</span></a>
      : <span class="dk-knopf" aria-disabled="true"><Icon name="telefon" /><span>Anrufen</span><small>Nummer folgt</small></span>}
    {WHATSAPP_LINK
      ? <a class="dk-knopf" href={WHATSAPP_LINK} rel="noopener" title={waTitel} aria-label="Funkelfilm per WhatsApp schreiben (WhatsApp öffnet sich)"><Icon name="whatsapp" /><span>WhatsApp</span></a>
      : <span class="dk-knopf" aria-disabled="true"><Icon name="whatsapp" /><span>WhatsApp</span><small>Nummer folgt</small></span>}
    {art === "leiste" && <a class="dk-knopf dk-hoch" href="#inhalt" aria-label="Nach oben"><Icon name="hoch" /></a>}
    {hinweis && <p class="dk-hinweis">WhatsApp öffnet die App auf deinem Gerät. Dabei gelten die Datenschutzregeln von WhatsApp (Meta).</p>}
  </div>
)}
<style>
  .dk { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .dk-knopf { display: inline-flex; align-items: center; gap: 0.55rem; min-height: 3rem; padding: 0.65rem 1.15rem; border: 1px solid var(--rahmen);
    border-radius: 2px; color: var(--tinte); font: 600 0.98rem/1.2 var(--titel); background: transparent; }
  /* Hover nur mit Maus: auf Touch-Geräten bliebe die Markierung nach dem Tippen stehen */
  @media (hover: hover) { a.dk-knopf:hover { border-color: var(--tinte); background: rgba(255, 204, 0, 0.16); } }
  .dk-knopf :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--akzent-linie); flex: none; }
  .dk-knopf small { font: 500 0.75rem/1 var(--text); color: var(--rot-klein); white-space: nowrap; }
  .dk.offen .dk-knopf { outline: 2px dashed var(--rot-vorschau); outline-offset: 2px; cursor: default; }
  .dk-hinweis { flex-basis: 100%; margin: 0; font-size: 0.85rem; color: var(--tinte-leise); }

  .dk-menue { margin-top: 0.9rem; }
  .dk-menue .dk-knopf { flex: 1 1 8rem; justify-content: center; }

  /* Feste Leiste am Handy: zwei gleich breite Felder unten, über dem Seiteninhalt; „Nach oben“ rückt darüber (NachOben.astro) */
  .dk-leiste { position: fixed; left: 0; right: 0; bottom: 0; z-index: 45; gap: 0; flex-wrap: nowrap;
    padding: 0.5rem max(0.75rem, env(safe-area-inset-right)) max(0.5rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    background: rgba(43, 45, 49, 0.97); border-top: 1px solid var(--linie-dunkel); transition: transform 0.3s var(--ease); }
  .dk-leiste .dk-knopf { flex: 1 1 50%; justify-content: center; gap: 0.4rem; min-height: 2.9rem; padding-inline: 0.5rem; border: 0; font-size: 0.92rem; }
  .dk-leiste .dk-knopf small { font-size: 0.68rem; }
  .dk-leiste .dk-knopf + .dk-knopf { border-left: 1px solid var(--linie-dunkel); }
  /* „Nach oben“ sitzt am Handy in der Leiste statt schwebend über dem Text (Jamil 4267) */
  .dk-leiste .dk-hoch { flex: 0 0 3.25rem; padding-inline: 0; }
  .dk-leiste.offen .dk-knopf { outline-offset: -3px; }
  :global(.js) .dk-leiste:not(.sichtbar):not(:focus-within) { transform: translateY(110%); } /* mit Tab erreicht → sichtbar (Prüfung 09.11.) */
  @media (min-width: 48rem) { .dk-leiste { display: none; } }
  @media (prefers-reduced-motion: reduce) { .dk-leiste { transition: none; } }
</style>
