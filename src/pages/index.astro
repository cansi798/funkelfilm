---
// Startseite nach Jamils Konzept „FUNKELFILM 2027“ (Talk 4222, 01.11.2026): Besucher zuerst verstehen, dann Funkelfilm als Lösung zeigen.
// Hero → Vertrauen → „Kommt dir das bekannt vor?“ → Lösung → Projekte → Mensch → Einsatzgebiet (Can 4242) → Ziele → Stimmen → Ablauf → Fragen → Schluss (im Layout).
// Kompakt gehalten (Can: möglichst wenig Scrollen): am Handy wischbare Reihen und aufklappbare Karten.
import Basis from "../layouts/Basis.astro";
import HeroFilm from "../components/HeroFilm.astro";
import Problem from "../components/Problem.astro";
import Loesung from "../components/Loesung.astro";
import Referenzen from "../components/Referenzen.astro";
import Mensch from "../components/Mensch.astro";
import Einsatzgebiet from "../components/Einsatzgebiet.astro";
import Ziele from "../components/Ziele.astro";
import StimmenBand from "../components/StimmenBand.astro";
import AblaufLinie from "../components/AblaufLinie.astro";
import Fragen from "../components/Fragen.astro";
import { u } from "../daten";
import Vertrauen from "../components/Vertrauen.astro";
import KiVergleich from "../components/KiVergleich.astro";
---
<Basis titel="Unternehmensfilme aus Hamburg & deutschlandweit" vorladen={u("/medien/clips/reel.webp")} beschreibung="Funkelfilm aus Hamburg dreht deutschlandweit: Unternehmensfilme, Recruitingfilme, Kundenstimmen und Eventfilme. Wir erzählen deine Geschichte so, dass Kunden Vertrauen aufbauen, bevor sie Kontakt aufnehmen.">
  <HeroFilm />

  <Vertrauen />

  <Problem />
  <Loesung />
  <KiVergleich />
  <Referenzen />
  <Mensch />
  <Einsatzgebiet />
  <Ziele />
  <StimmenBand />
  <AblaufLinie />
  <Fragen />
</Basis>
<style>
  :global(.kompakt) { padding-block: clamp(2.25rem, 4.5vw, 3.5rem); }
</style>
